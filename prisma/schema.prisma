// TopNow schema.
//
// One table drives the product. A queue entry and a completed sale are the same
// `Purchase` record at different points in its life:
//
//     queued --promotion--> live --expiry--> ended
//        \                    \
//         `----- killed -------'   (admin, #17)
//
// board = status live · queue = status queued, oldest first · tape = status
// ended, newest first · chart = priceHrCents against boughtAt. All four are
// queries over this one table, never separate tables.
//
// Liveness is derived from timestamps, not from `status` — see #1. A rental
// whose window has passed has ended whether or not any process noticed. Status
// is a materialised convenience for indexing and for the ledger's three
// sections; where the two disagree, the timestamps win.
//
// Prisma 7 note: the connection URL lives in prisma.config.ts (CLI, migrations)
// and in the driver adapter in src/lib/db.ts (runtime). Not in this file.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Platform {
  github
  youtube
  instagram
  tiktok
  reddit
  web
}

enum PurchaseStatus {
  queued
  live
  ended
  killed
}

model Purchase {
  id String @id @default(uuid()) @db.Uuid

  /// 1 | 2 | 3. Constrained in the migration.
  slot Int

  handle   String   @db.VarChar(64)
  platform Platform

  /// Websites have no handle to show, so they carry a display name instead.
  /// Constrained in the migration to be present for `web` and absent otherwise.
  displayName String? @db.VarChar(24)

  /// Derived from platform + handle, or supplied for websites. Always absolute.
  targetUrl String @db.VarChar(2048)

  /// The post to embed on slot 01 (#20). Optional, and only meaningful for the
  /// three platforms with a public oEmbed endpoint.
  ///
  /// Needed because a listing carries a *profile* handle and oEmbed takes a
  /// *post* URL — without this column there is nothing for #20 to resolve.
  /// Constrained in the migration to be https and absent for platforms that
  /// have no embed.
  postUrl String? @db.VarChar(2048)

  /// Clicks on this listing's link, counted by TopNow (#20). Never a figure
  /// borrowed from a platform: this is the one engagement number the product
  /// can actually measure, which is why it is the one it is allowed to print.
  clicks Int @default(0)

  tagline String @db.VarChar(60)

  /// 1 | 3 | 6 | 12 | 24. A snap point, constrained in the migration.
  durationH Int

  /// The ask at checkout, locked. Nobody already queued is ever re-priced.
  /// Integer cents — money is never a float.
  priceHrCents Int

  /// priceHrCents * durationH, written by the Stripe webhook (#26) from the
  /// locked session metadata rather than recomputed.
  totalPaidCents Int

  /// The print on the chart.
  boughtAt DateTime @default(now()) @db.Timestamptz(3)

  /// Null until promoted. Constrained in the migration to be non-null exactly
  /// when the row is not queued.
  startsAt DateTime? @db.Timestamptz(3)

  /// startsAt + durationH. Enforced in the migration, not assumed.
  endsAt DateTime? @db.Timestamptz(3)

  status PurchaseStatus @default(queued)

  /// Set when an admin kills a listing (#17). The row stays in the ledger.
  killedAt     DateTime? @db.Timestamptz(3)
  killedReason String?   @db.VarChar(500)

  /// Stripe's checkout session id. Unique, which is what makes the webhook
  /// idempotent under duplicate delivery (#26) — a constraint, not a check.
  stripeSessionId String? @unique @db.VarChar(255)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  // Board, queue and tape reads all filter by slot and status and order by
  // boughtAt.
  @@index([slot, status, boughtAt])
  // The tape, across all slots.
  @@index([status, boughtAt])
  // Expiry and promotion scan live rentals by when they end.
  @@index([status, endsAt])
  @@map("purchase")
}

/// One row per slot per hour: the ask, sampled (#22). This is the series the
/// chart's candles are built from (#12), and it is why the chart has a line
/// even in an hour with no sales.
///
/// A missed hour stays missing. Nothing backfills or interpolates it — #13
/// renders the gap honestly.
model AskSample {
  id Int @id @default(autoincrement())

  slot Int

  /// Truncated to the hour, UTC. Unique with slot, which makes #22's hourly
  /// job idempotent under repeat and concurrent runs.
  hour DateTime @db.Timestamptz(3)

  /// The ask at sample time, in integer cents.
  askHrCents Int

  /// The slot's base rate at sample time, so a later change to base rates does
  /// not silently rewrite chart history.
  baseHrCents Int

  /// Queued hours at sample time — the input to surge under decision D2.
  queuedHours Int

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([slot, hour])
  @@index([slot, hour])
  @@map("ask_sample")
}

enum AvatarStatus {
  /// Bytes were fetched, validated and re-encoded. `large` and `small` are set.
  ok
  /// There is no avatar to fetch, and asking again will not change that:
  /// no resolver for the platform, a website listing, or a handle whose
  /// upstream response was not an image.
  unavailable
  /// Something transient — a timeout, a 5xx, a blocked address. Retried on the
  /// schedule in constants.ts, never on a page read.
  failed
}

/// TopNow's own copy of a listing's avatar (#19).
///
/// The board never causes a third-party request: it reads this table, and the
/// bytes are served from /api/avatar. Resolution happens on purchase creation
/// and on the hourly refresh, never on a read.
///
/// Keyed by platform and handle rather than by purchase, because the same
/// account can rent a slot many times and each rental should not re-fetch.
/// `handle` is stored lowercased — see `avatarKey`.
model Avatar {
  id String @id @default(uuid()) @db.Uuid

  platform Platform
  handle   String   @db.VarChar(64)

  status AvatarStatus

  /// Always image/webp when status is ok. Nullable because a row that failed has
  /// no bytes to describe.
  contentType String? @db.VarChar(64)

  /// Re-encoded, metadata stripped, at the two sizes the board actually renders.
  /// Never the upstream bytes.
  large Bytes?
  small Bytes?

  /// The URL the bytes finally came from, after redirects. For debugging a bad
  /// resolution without keeping the response.
  sourceUrl String? @db.VarChar(2048)

  /// Why a non-ok row is not ok. Short, and never the upstream body.
  failureReason String? @db.VarChar(500)

  /// Consecutive failures. Kept so a permanently broken handle is visible as a
  /// number rather than as a pattern in the logs.
  attempts Int @default(0)

  /// When resolution last ran, successfully or not. Drives the refresh schedule.
  resolvedAt DateTime @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  /// One row per account. This is what makes resolution idempotent under
  /// concurrent webhook deliveries for the same handle.
  @@unique([platform, handle])
  /// The refresh job scans by staleness.
  @@index([status, resolvedAt])
  @@map("avatar")
}

enum EmbedStatus {
  /// The provider answered and the post is renderable.
  ok
  /// Settled: no embed for this platform, or the post is gone. Not retried.
  unavailable
  /// Transient — a timeout, a 5xx. Retried on the schedule in constants.ts.
  failed
}

/// A resolved oEmbed for a post (#20).
///
/// Keyed by the post URL rather than by the purchase, because the same post can
/// be rented more than once and each rental should not re-ask the provider.
///
/// Negative results are cached too. Without that, a deleted post becomes an
/// outbound request on every refresh cycle forever — which is the rate-limit
/// budget #18 is about.
model Embed {
  id String @id @default(uuid()) @db.Uuid

  /// Normalised: scheme and host lowercased, tracking parameters stripped.
  postUrl  String   @unique @db.VarChar(2048)
  platform Platform

  status EmbedStatus

  /// From the provider's oEmbed response. Rendered as text, never as markup.
  title      String? @db.VarChar(300)
  authorName String? @db.VarChar(120)

  /// The provider's iframe, kept only after `iframeSrcOf` has proved it is a
  /// single iframe pointing at an allow-listed host. Rendered on demand, in a
  /// sandbox, never on first paint.
  iframeSrc    String? @db.VarChar(2048)
  iframeWidth  Int?
  iframeHeight Int?

  /// TopNow's own copy of the provider's thumbnail, re-encoded like an avatar.
  /// Stored rather than hotlinked so the board makes no third-party request.
  thumbnail      Bytes?
  thumbnailWidth Int?

  /// Views, only when the provider actually reports them. Almost never: none of
  /// YouTube, TikTok or Reddit put a view count in an oEmbed response. Nullable
  /// because "we do not know" is the truth, and the footer omits the row.
  providerViews Int?

  failureReason String? @db.VarChar(500)
  attempts      Int     @default(0)

  resolvedAt DateTime @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([status, resolvedAt])
  @@map("embed")
}

/// One visitor, in one window (#15).
///
/// The hit counter is only a joke worth telling if the number is real, so this
/// is what the number is counted from. A row is a **visit**: one visitor seen in
/// one thirty-minute window. Reloading the page ten times in a row is one visit;
/// coming back after lunch is a second.
///
/// `visitorHash` is a one-way hash of the request's address and user agent with
/// a salt that rotates daily. It is not reversible to a person and cannot be
/// used to follow anyone across days, which is the point: the counter needs to
/// know "same visitor or different", and nothing beyond that.
model Visit {
  id Int @id @default(autoincrement())

  /// sha256, hex. Never an address, never a user agent.
  visitorHash String @db.VarChar(64)

  /// Start of the window this visit falls in. Unique with the hash, which is
  /// what makes a reload idempotent rather than a second visit.
  bucket DateTime @db.Timestamptz(3)

  firstSeenAt DateTime @default(now()) @db.Timestamptz(3)

  /// Bumped on every render inside the window. This is what "online now" reads:
  /// a visitor seen in the last few minutes, not one who arrived at some point
  /// in the last half hour.
  lastSeenAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([visitorHash, bucket])
  @@index([lastSeenAt])
  @@map("visit")
}
