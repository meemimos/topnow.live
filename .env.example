# Copy to .env.local for development. Never commit a filled-in copy.
#
# These are read through the validated config module in src/lib/config — never
# through process.env directly, which ESLint enforces. The server refuses to
# start if anything required here is missing or malformed, and names it.
#
#   src/lib/config/server.ts  server-only values; never reach the browser
#   src/lib/config/client.ts  NEXT_PUBLIC_* only; safe to ship to the browser

# --- Database (#21) ---
DATABASE_URL="postgresql://topnow:topnow@127.0.0.1:5432/topnow?schema=public"

# --- App ---
APP_URL="http://127.0.0.1:3000"

# --- Feature flags ---
# Decision D3: the market panel stays hidden until a slot has 20h of sampled
# ask (#22). Flip to "true" only when that threshold is genuinely met (#12).
NEXT_PUBLIC_MARKET_PANEL_ENABLED="false"

# --- Scheduler (#22) ---
# Authenticates the hourly job endpoint. At least 32 characters.
# Generate with: openssl rand -hex 32
CRON_SECRET="replace-me-with-at-least-thirty-two-characters"

# --- Stripe (#26) ---
# Placeholders let the app boot and the entire payment path be tested: the tests
# sign their own webhooks, so no credential is needed to exercise verification,
# idempotency, the cap re-check or refunds.
#
# Replace with real test-mode keys to talk to Stripe for real, and note that
# api.stripe.com must also be reachable from wherever this runs. The secret key
# belongs in the environment, never in a committed file.
STRIPE_SECRET_KEY="sk_test_placeholder_not_a_real_key"
STRIPE_WEBHOOK_SECRET="whsec_placeholder_not_a_real_secret"
# Publishable keys are not secret — they are meant to ship in the browser.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_placeholder_not_a_real_key"

# --- Rate limiting (#18) ---
# Written as `count/window+burst`, e.g. "20/1h+5" is twenty an hour of which
# five may be spent back-to-back. The burst is required, not optional: without
# one, "twenty an hour" means one every three minutes, and the person who
# resubmits after fixing a typo is the first one blocked.
#
# All five have defaults, so leaving them unset is a supported deployment. Set
# them when a real environment shows the defaults are wrong.
# RATE_LIMIT_CHECKOUT="20/1h+5"
# RATE_LIMIT_REPORT="10/1h+3"
# RATE_LIMIT_AVATAR="120/1h+20"
# RATE_LIMIT_EMBED="120/1h+20"
# RATE_LIMIT_ADMIN="10/15m+5"
#
# How many proxies sit in front of the app. Decides which x-forwarded-for entry
# a limit is keyed on, counting from the right — the left-hand entries are
# whatever the client chose to send. Too high trusts client-written text; too
# low buckets everyone behind the proxy together.
# RATE_LIMIT_TRUSTED_PROXIES="1"

# --- Everything below is added by the issue that needs it. ---
# Admin auth (#17):        ADMIN_*
# Avatar/oEmbed (#19,#20): AVATAR_*, OEMBED_*
