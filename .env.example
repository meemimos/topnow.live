# Copy to .env.local for development. Never commit a filled-in copy.
#
# These are read through the validated config module in src/lib/config — never
# through process.env directly, which ESLint enforces. The server refuses to
# start if anything required here is missing or malformed, and names it.
#
#   src/lib/config/server.ts  server-only values; never reach the browser
#   src/lib/config/client.ts  NEXT_PUBLIC_* only; safe to ship to the browser

# --- Database (#21) ---
DATABASE_URL="postgresql://topnow:topnow@127.0.0.1:5432/topnow?schema=public"

# --- App ---
APP_URL="http://127.0.0.1:3000"

# --- Feature flags ---
# Decision D3: the market panel stays hidden until a slot has 20h of sampled
# ask (#22). Flip to "true" only when that threshold is genuinely met (#12).
NEXT_PUBLIC_MARKET_PANEL_ENABLED="false"

# --- Everything below is added by the issue that needs it. ---
# Stripe (#26):            STRIPE_SECRET_KEY, STRIPE_PUBLISHABLE_KEY, STRIPE_WEBHOOK_SECRET
# Admin auth (#17):        ADMIN_*
# Rate limiting (#18):     RATE_LIMIT_*
# Avatar/oEmbed (#19,#20): AVATAR_*, OEMBED_*
# Scheduler auth (#22):    CRON_SECRET
